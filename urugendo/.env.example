# ── Database ──────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/urugendo_db

# ── JWT ───────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── MTN MoMo (Collections API) ────────────────────────
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_SUBSCRIPTION_KEY=your-mtn-subscription-key
MTN_MOMO_API_USER=your-api-user-uuid
MTN_MOMO_API_KEY=your-api-key
MTN_MOMO_ENVIRONMENT=sandbox           # sandbox | production
MTN_MOMO_CURRENCY=RWF
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/api/payments/mtn/callback

# ── Airtel Money ──────────────────────────────────────
AIRTEL_BASE_URL=https://openapi.airtel.africa
AIRTEL_CLIENT_ID=your-airtel-client-id
AIRTEL_CLIENT_SECRET=your-airtel-client-secret
AIRTEL_ENVIRONMENT=sandbox             # sandbox | production

# ── App ───────────────────────────────────────────────
APP_NAME=Urugendo
DEBUG=true
